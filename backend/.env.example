# Copy to backend/.env and fill in. Real environment variables override this file.

# --- 3D generator ---
# local: our own Hunyuan3D service (generator/, start it first), free, ~1-2 min per asset on an RTX 3060
# meshy: Meshy's paid API (needs MESHY_API_KEY; ~20-30 credits per model, ~5 per rig)
# mock:  offline placeholder cube, for building clients without a GPU or credits
# Default: meshy if MESHY_API_KEY is set, otherwise mock.
GENERATOR=local
# GENERATOR_URL=http://127.0.0.1:8100
# MAX_CONCURRENT_JOBS=1    # use 1 with GENERATOR=local: one GPU
MESHY_API_KEY=
# MOCK_SECONDS=6           # how long a mock job pretends to take

# --- Classifier ---
# manual: use the category picked at upload ("auto" falls back to prop)
# openai: call an OpenAI-compatible vision endpoint
CLASSIFIER=manual
# BenchAI / MegaMan.EXE vision model (Qwen2-VL) on Cesar's PC:
# CLASSIFIER_URL=http://127.0.0.1:8085/v1
# CLASSIFIER_MODEL=vision
# CLASSIFIER_API_KEY=<BENCHAI_API_KEY from benchai/router/.env>
# Or OpenAI: CLASSIFIER_URL=https://api.openai.com/v1  CLASSIFIER_MODEL=gpt-4o-mini  CLASSIFIER_API_KEY=sk-...

# --- Photo quality gate ---
# BLUR_THRESHOLD=100       # Laplacian variance; sharp phone photos score ~500-4000
# DARK_THRESHOLD=30
# BRIGHT_THRESHOLD=235
# MIN_SIDE=512
# MAX_UPLOAD_MB=15

# DATA_DIR=./data          # SQLite DB + per-job files
